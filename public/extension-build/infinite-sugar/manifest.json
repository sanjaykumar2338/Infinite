{
  "name": "InfiniteSugar",
  "description": "Chrome desktop guidance for supported Zoom web meeting pages.",
  "version": "1.6.2",
  "manifest_version": 3,
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "InfiniteSugar",
    "default_icon": "assets/icon.png"
  },
  "permissions": ["storage", "identity", "tabs", "windows", "scripting"],
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "https://www.infinitesugar.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://app.zoom.us/*",
    "https://api.emailjs.com/*",
    "https://firestore.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zoom.us/wc/*",
        "https://*.zoom.us/wc/*",
        "https://app.zoom.us/wc/*",
        "https://zoom.us/j/*",
        "https://*.zoom.us/j/*",
        "https://app.zoom.us/j/*",
        "https://zoom.us/my/*",
        "https://*.zoom.us/my/*",
        "https://app.zoom.us/my/*"
      ],
      "js": ["extension-config.js", "contentScript.js"],
      "css": ["contentStyle.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["analyzer.html", "analyzer.js", "*.js"],
      "matches": ["https://zoom.us/*", "https://*.zoom.us/*", "https://app.zoom.us/*"]
    },
    {
      "resources": ["assets/*.svg", "assets/*.png", "assets/fonts/*"],
      "matches": ["https://zoom.us/*", "https://*.zoom.us/*", "https://app.zoom.us/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.infinitesugar.com https://api.emailjs.com https://accounts.google.com https://www.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com;"
  },
  "key": ""
}
