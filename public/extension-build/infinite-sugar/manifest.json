{
  "name": "InfiniteSugar",
  "description": "Your Real-Time AI Coach for Every Call.",
  "version": "1.6.1",
  "manifest_version": 3,
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "InfiniteSugar",
    "default_icon": "assets/icon.png"
  },
  "permissions": ["storage", "identity", "tabs", "windows"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://mickolidia.easytechinfo.net/*",
    "https://api.emailjs.com/*",
    "https://firestore.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.zoom.us/wc/*"],
      "js": ["contentScript.js"],
      "css": ["contentStyle.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["analyzer.html"],
      "matches": ["https://*.zoom.us/*"]
    },
    {
      "resources": ["assets/*.svg"],
      "matches": ["https://*.zoom.us/*"]
    }
  ],
  "key": ""
}
